# Copy to .env and fill in. Never commit .env.

# Long random string that signs logins. Generate with: openssl rand -base64 48
JWT_SECRET=

# Your admin account, created the first time the server starts with an empty database.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Call Scheduler

# Contact shown on the sign-in pages for anyone who can't sign in (optional).
SUPPORT_EMAIL=

# Daily database backups in /data/backups: how many to keep (0 = off).
BACKUP_KEEP=14

# Set to true when behind a reverse proxy or Cloudflare Tunnel.
TRUST_PROXY=false

# Only for a second copy on the same server (e.g. a test site): its container
# name, the port it listens on, and a banner shown on every page.
# INSTANCE=call-planner-test
# HOST_PORT=4001
# INSTANCE_LABEL=Test copy
